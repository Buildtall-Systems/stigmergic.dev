package templates

import (
	"github.com/buildtall-systems/buildtall/btk/views/login"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
	"github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"
)

// Login renders the btk login panel: a NIP-07 extension, a pasted bunker
// link, or a NIP-46 QR code. next is where a completed login lands.
templ Login(paths login.Paths, next string, thm *theme.Theme, themes []*theme.Theme) {
	@components.LoginLayout(thm, themes) {
		<div class="flex flex-col items-center gap-6 w-full px-4 py-8">
			@components.BuildtallLogo()
			@login.LoginPanelAt(paths, "stigmergic", next)
		</div>
	}
}
