package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"

templ Markdown(title string, breadcrumbs []models.Breadcrumb, content string, rawContent string, rootPath string, relativePath string, thm *theme.Theme, themes []*theme.Theme, files []models.SearchableFile, tree *models.Tree, recentFiles []models.SearchableFile, indexReady bool, backlinks []models.BacklinkEntry, metadata map[string]any, caps models.UICapabilities, outline []models.OutlineEntry) {
	@components.Layout(title, thm, themes, files, tree, recentFiles, indexReady, caps, outline) {
		@MarkdownContent(breadcrumbs, content, rawContent, rootPath, relativePath, backlinks, metadata, caps)
	}
}

templ MarkdownContent(breadcrumbs []models.Breadcrumb, content string, rawContent string, rootPath string, relativePath string, backlinks []models.BacklinkEntry, metadata map[string]any, caps models.UICapabilities) {
	<div class="space-y-6">
		if len(breadcrumbs) > 0 {
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<div class="flex items-center justify-between gap-4">
					<ol class="flex items-center space-x-2">
						<li class="inline-flex items-center">
							<a href="/" hx-get="/" hx-target="#content" hx-swap="innerHTML" hx-push-url="true" class="font-medium transition-colors">
								{ rootPath }
							</a>
						</li>
						for i, crumb := range breadcrumbs {
							<li>
								<div class="flex items-center">
									<span class="breadcrumb-separator mx-2" style="color: var(--comment-color);">/</span>
									if i == len(breadcrumbs) - 1 {
										<span class="font-medium">{ crumb.Name }</span>
									} else {
										<a href={ templ.SafeURL(crumb.Path) } hx-get={ crumb.Path } hx-target="#content" hx-swap="innerHTML" hx-push-url="true" class="font-medium transition-colors" style="color: var(--comment-color);">{ crumb.Name }</a>
									}
								</div>
							</li>
						}
					</ol>
					if caps.CopyPath {
						<div x-data={ "copyPath('" + relativePath + "')" }>
							<button
								@click="copy()"
								class="p-1 rounded-sm transition-colors"
								style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);"
								:style="copied ? 'color: var(--green-color)' : 'color: var(--comment-color)'"
								:title="copied ? 'Copied!' : 'Copy path'"
							>
								<span x-show="!copied">
									@components.IconCopy("w-4 h-4", "")
								</span>
								<span x-show="copied" x-cloak>
									@components.IconCheck("w-4 h-4", "")
								</span>
							</button>
						</div>
					}
				</div>
			</nav>
		}
		if len(metadata) > 0 {
			<div x-data="{ fmOpen: false }" class="rounded-md" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">
				<button @click="fmOpen = !fmOpen" class="w-full flex items-center justify-between px-4 py-2 text-sm cursor-pointer" style="color: var(--comment-color);">
					<span style="font-family: monospace;">Frontmatter</span>
					<svg class="w-4 h-4 transition-transform" :class="fmOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
					</svg>
				</button>
				<div x-show="fmOpen" x-cloak class="px-4 pb-3">
					<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 items-baseline">
						for _, key := range SortedMetadataKeys(metadata) {
							if mv := ClassifyMetadataValue(metadata[key]); !mv.IsHidden {
								<dt class="text-right" style="color: var(--comment-color); font-family: monospace; font-size: 0.875rem;">{ key }</dt>
								<dd style="font-size: 0.875rem;">
									if mv.IsArray {
										<div class="flex flex-wrap gap-1">
											for _, tag := range mv.ArrayVal {
												<span class="inline-block rounded-full px-2 py-0.5 text-xs" style="background-color: var(--cyan-color); color: var(--bg-color);">{ tag }</span>
											}
										</div>
									} else {
										<span style="color: var(--fg-color);">{ mv.StringVal }</span>
									}
								</dd>
							}
						}
					</dl>
				</div>
			</div>
		}
		@templ.JSONScript("raw-content-data", rawContent)
		<div x-data="rawToggle()" @toggle-source.window="toggle()">
			<div class="flex justify-end gap-2 mb-4">
				<button
					x-show="showRaw"
					@pointerdown="showLineNumbers = true"
					@pointerup="showLineNumbers = false"
					@pointerleave="showLineNumbers = false"
					class="px-3 py-1 text-sm rounded-sm transition-colors"
					style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);"
					:style="showLineNumbers ? 'color: var(--green-color)' : 'color: var(--fg-color)'"
				>Lines</button>
				<button
					@click="toggle()"
					class="px-3 py-1 text-sm rounded-sm transition-colors"
					style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color); color: var(--fg-color);"
					x-text="buttonText"
				></button>
			</div>
			<article x-show="!showRaw" class="prose prose-headings:font-bold prose-a:no-underline prose-a:hover:underline max-w-[72ch] mx-auto">
				@templ.Raw(content)
			</article>
			<div x-show="showRaw" x-cloak class="overflow-x-auto rounded-md" style="background-color: var(--code-bg-color);">
				<table class="w-full" style="border-collapse: collapse;">
					<tbody>
						<template x-for="(line, index) in lines" :key="index">
							<tr>
								<td
									x-show="showLineNumbers"
									class="select-none text-right pr-4 pl-2 py-0"
									style="color: var(--line-number-color); font-family: monospace; font-size: 0.875rem; vertical-align: top; user-select: none; min-width: 3rem;"
									x-text="index + 1"
								></td>
								<td
									class="py-0 w-full"
									style="color: var(--code-fg-color); font-family: monospace; font-size: 0.875rem; white-space: pre-wrap; word-break: break-word;"
									x-text="line || ' '"
								></td>
							</tr>
						</template>
					</tbody>
				</table>
			</div>
		</div>
		if len(backlinks) > 0 {
			<div class="mt-8 rounded-md px-4 py-3" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">
				<h3 class="text-sm font-semibold mb-2" style="color: var(--comment-color);">Backlinks</h3>
				<ul class="space-y-1">
					for _, bl := range backlinks {
						<li class="text-sm">
							<a href={ templ.SafeURL("/file/" + bl.SourcePath) } class="transition-colors hover:underline" style="color: var(--link-color);">{ bl.SourceTitle }</a>
						</li>
					}
				</ul>
			</div>
		}
	</div>
}
