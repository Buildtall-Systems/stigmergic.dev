package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"

templ Markdown(title string, breadcrumbs []models.Breadcrumb, content string, rootPath string, thm *theme.Theme, files []models.SearchableFile) {
	@components.Layout(title, thm, files) {
		@MarkdownContent(breadcrumbs, content, rootPath)
	}
}

templ MarkdownContent(breadcrumbs []models.Breadcrumb, content string, rootPath string) {
	<div class="space-y-6">
		if len(breadcrumbs) > 0 {
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol class="flex items-center space-x-2">
					<li class="inline-flex items-center">
						<a href="/" class="font-medium transition-colors">
							{ rootPath }
						</a>
					</li>
					for i, crumb := range breadcrumbs {
						<li>
							<div class="flex items-center">
								<span class="breadcrumb-separator mx-2" style="color: var(--comment-color);">/</span>
								if i == len(breadcrumbs) - 1 {
									<span class="font-medium">{ crumb.Name }</span>
								} else {
									<a href={ templ.SafeURL(crumb.Path) } class="font-medium transition-colors" style="color: var(--comment-color);">{ crumb.Name }</a>
								}
							</div>
						</li>
					}
				</ol>
			</nav>
		}
		<article class="prose prose-headings:font-bold prose-a:no-underline hover:prose-a:underline max-w-none">
			@templ.Raw(content)
		</article>
	</div>
}
