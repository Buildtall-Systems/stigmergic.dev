package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Markdown(title string, breadcrumbs []string, content string, thm *theme.Theme) {
	@components.Layout(title, thm) {
		@MarkdownContent(breadcrumbs, content)
	}
}

templ MarkdownContent(breadcrumbs []string, content string) {
	<div class="space-y-6">
		if len(breadcrumbs) > 0 {
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol class="flex items-center space-x-2">
					<li class="inline-flex items-center">
						<a href="/" class="font-medium transition-colors">
							Home
						</a>
					</li>
					for i, crumb := range breadcrumbs {
						<li>
							<div class="flex items-center">
								<span class="breadcrumb-separator mx-2" style="color: var(--comment-color);">/</span>
								if i == len(breadcrumbs) - 1 {
									<span class="font-medium">{ crumb }</span>
								} else {
									<span style="color: var(--comment-color);">{ crumb }</span>
								}
							</div>
						</li>
					}
				</ol>
			</nav>
		}
		<article class="prose prose-headings:font-bold prose-a:no-underline hover:prose-a:underline max-w-none">
			@templ.Raw(content)
		</article>
	</div>
}
