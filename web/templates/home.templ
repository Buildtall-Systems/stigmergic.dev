package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Home(tree *models.Tree, rootPath string, thm *theme.Theme, files []models.SearchableFile) {
	@components.Layout("Home", thm, files) {
		<div class="space-y-4">
			<h2 class="text-xl font-semibold">{ rootPath }</h2>
			if tree == nil || tree.Root == nil {
				<p style="color: var(--comment-color);">No markdown files found.</p>
			} else {
				@components.Tree(tree.Root)
			}
		</div>
	}
}
