package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Home(tree *models.Tree, rootPath string, thm *theme.Theme, files []models.SearchableFile, recentFiles []models.SearchableFile, indexReady bool) {
	@components.Layout("Home", thm, files, indexReady) {
		@HomeContent(tree, rootPath, recentFiles, indexReady)
	}
}

templ HomeContent(tree *models.Tree, rootPath string, recentFiles []models.SearchableFile, indexReady bool) {
	<div class="space-y-4">
		<h2 class="text-xl font-semibold">{ rootPath }</h2>
		@components.RecentlyUpdated(recentFiles, indexReady)
		if !indexReady {
			<p style="color: var(--comment-color);">Indexing...</p>
		} else if tree == nil || tree.Root == nil {
			<p style="color: var(--comment-color);">No markdown files found.</p>
		} else {
			@components.Tree(tree.Root)
		}
	</div>
}
