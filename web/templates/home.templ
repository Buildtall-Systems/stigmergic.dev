package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Home(tree *models.Tree) {
	@components.Layout("Home") {
		<div class="space-y-4">
			<h2 class="text-xl font-semibold text-gray-900">Markdown Files</h2>
			if tree == nil || tree.Root == nil {
				<p class="text-gray-500">No markdown files found.</p>
			} else {
				@renderTree(tree.Root)
			}
		</div>
	}
}

templ renderTree(node *models.Node) {
	<ul class="space-y-1">
		for _, child := range node.Children {
			<li>
				if child.IsDir() {
					<div class="flex items-center space-x-2">
						<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
						</svg>
						<span class="font-medium text-gray-700">{ child.Name }</span>
					</div>
					if len(child.Children) > 0 {
						<div class="ml-6 mt-1">
							@renderTree(child)
						</div>
					}
				} else {
					<a href={ templ.SafeURL("/file/" + templ.EscapeString(child.Path)) } class="flex items-center space-x-2 hover:text-blue-600 transition-colors">
						<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<span class="text-gray-600">{ child.Name }</span>
					</a>
				}
			</li>
		}
	</ul>
}
