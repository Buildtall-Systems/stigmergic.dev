package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Home(tree *models.Tree, thm *theme.Theme) {
	@components.Layout("Home", thm) {
		<div class="space-y-4">
			<h2 class="text-xl font-semibold">Markdown Files</h2>
			if tree == nil || tree.Root == nil {
				<p style="color: var(--comment-color);">No markdown files found.</p>
			} else {
				@renderTree(tree.Root)
			}
		</div>
	}
}

templ renderTree(node *models.Node) {
	<ul class="space-y-1 pl-2">
		for _, child := range node.Children {
			<li>
				if child.IsDir() {
					<div class="tree-item">
						<svg class="tree-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
						</svg>
						<span class="tree-item-text tree-item-folder">{ child.Name }</span>
					</div>
					if len(child.Children) > 0 {
						<div class="ml-4 mt-1">
							@renderTree(child)
						</div>
					}
				} else {
					<a
						href={ templ.SafeURL("/file/" + templ.EscapeString(child.Path)) }
						class="tree-item group"
						hx-get={ "/file/" + templ.EscapeString(child.Path) }
						hx-target="main"
						hx-swap="innerHTML"
						hx-push-url="true"
					>
						<svg class="tree-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
						</svg>
						<span class="tree-item-text">{ child.Name }</span>
					</a>
				}
			</li>
		}
	</ul>
}
