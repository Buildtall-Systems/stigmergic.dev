package components

templ LiveIndicator() {
	<div x-data="liveIndicator()" class="flex items-center gap-2">
		<span
			class="indicator-dot w-2 h-2 rounded-full transition-colors"
			:class="stateClass"
		></span>
		<span
			class="text-sm"
			style="color: var(--comment-color);"
			x-text="statusText"
		></span>
	</div>
	<script>
		window.sseConnectionState = window.sseConnectionState || 'connecting'

		document.body.addEventListener('htmx:sseOpen', () => {
			window.sseConnectionState = 'connected'
		})
		document.body.addEventListener('htmx:sseError', () => {
			window.sseConnectionState = 'reconnecting'
		})
		document.body.addEventListener('htmx:sseClose', () => {
			window.sseConnectionState = 'disconnected'
		})

		function liveIndicator() {
			return {
				state: window.sseConnectionState,

				init() {
					this.state = window.sseConnectionState

					document.body.addEventListener('htmx:sseOpen', () => {
						this.state = 'connected'
					})
					document.body.addEventListener('htmx:sseError', () => {
						this.state = 'reconnecting'
					})
					document.body.addEventListener('htmx:sseClose', () => {
						this.state = 'disconnected'
					})
					document.body.addEventListener('sse:message', () => {
						this.state = 'reloading'
					})
					document.body.addEventListener('htmx:afterSwap', () => {
						if (this.state === 'reloading') {
							this.state = 'connected'
						}
					})
				},

				get stateClass() {
					return {
						'connecting': 'indicator-connecting',
						'connected': 'indicator-connected',
						'disconnected': 'indicator-disconnected',
						'reconnecting': 'indicator-reconnecting',
						'reloading': 'indicator-reloading'
					}[this.state]
				},

				get statusText() {
					return {
						'connecting': 'Connecting...',
						'connected': 'Live',
						'disconnected': 'Offline',
						'reconnecting': 'Reconnecting...',
						'reloading': 'Updating...'
					}[this.state]
				}
			}
		}
	</script>
}
