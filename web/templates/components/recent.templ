package components

import (
	"path"
	"strings"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/models"
)

templ RecentlyUpdated(files []models.SearchableFile, indexReady bool) {
	if !indexReady {
		<div class="mb-6 rounded-lg p-4" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">
			<h3 class="text-lg font-medium mb-3" style="color: var(--keyword-color);">
				Recently Updated
			</h3>
			<p class="px-3 py-2" style="color: var(--comment-color);">Indexing...</p>
		</div>
	} else if len(files) > 0 {
		<div class="mb-6 rounded-lg p-4" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">
			<h3 class="text-lg font-medium mb-3" style="color: var(--keyword-color);">
				Recently Updated
			</h3>
			<ul class="space-y-1">
				for _, f := range files {
					<li>
						<a
							href={ templ.SafeURL(f.Path) }
							hx-get={ f.Path }
							hx-target="#content"
							hx-swap="innerHTML"
							hx-push-url="true"
							data-nav-item
							class="block px-3 py-2 rounded-md transition-colors cursor-pointer focus:outline-hidden"
						>
							<span style="color: var(--string-color);">
								{ trimMdExtension(f.Name) }
							</span>
							if dir := getDir(f.Path); dir != "/" {
								<span class="text-xs ml-2" style="color: var(--comment-color); opacity: 0.7;">
									{ dir }
								</span>
							}
							<span style="color: var(--comment-color);">
								{ " · " }{ f.RelativeTime }
							</span>
						</a>
					</li>
				}
			</ul>
		</div>
	}
}

func trimMdExtension(name string) string {
	return strings.TrimSuffix(name, ".md")
}

func getDir(filePath string) string {
	return path.Dir(filePath)
}
