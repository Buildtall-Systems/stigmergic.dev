package components

import (
	"strconv"
	"strings"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/models"
	"github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
)

func themeVars(c theme.Colors) string {
	return `
		--bg-color: ` + c.Background + `;
		--fg-color: ` + c.Foreground + `;
		--bg-alt-color: ` + c.BackgroundAlt + `;
		--comment-color: ` + c.Comment + `;
		--current-line-color: ` + c.CurrentLine + `;
		--selection-color: ` + c.Selection + `;
		--line-number-color: ` + c.LineNumber + `;
		--line-number-active-color: ` + c.LineNumberActive + `;
		--red-color: ` + c.Red + `;
		--orange-color: ` + c.Orange + `;
		--yellow-color: ` + c.Yellow + `;
		--green-color: ` + c.Green + `;
		--cyan-color: ` + c.Cyan + `;
		--blue-color: ` + c.Blue + `;
		--purple-color: ` + c.Purple + `;
		--link-color: ` + c.Link + `;
		--link-hover-color: ` + c.LinkHover + `;
		--code-bg-color: ` + c.CodeBg + `;
		--code-fg-color: ` + c.CodeFg + `;
		--border-color: ` + c.BorderColor + `;
	`
}

// ThemeCSS emits the boot theme's variables on :root, a [data-theme]-scoped
// variable block per embedded theme so the pre-paint attribute switches
// palettes without a round trip, each theme's scoped chroma stylesheet, and
// the shared component rules. Shared by the main layout and the login page.
func ThemeCSS(thm *theme.Theme, themes []*theme.Theme) string {
	var b strings.Builder
	b.WriteString(`<style type="text/css">:root {`)
	b.WriteString(themeVars(thm.Colors))
	b.WriteString("}\n")
	for _, t := range themes {
		b.WriteString(`[data-theme="` + t.Name + `"] {`)
		b.WriteString(themeVars(t.Colors))
		b.WriteString("}\n")
	}
	for _, t := range themes {
		b.WriteString(t.ChromaCSS)
	}
	b.WriteString(sharedThemeRules)
	b.WriteString(`</style>`)
	return b.String()
}

// PrePaintScript applies the persisted theme attribute before first paint —
// the one script that must stay inline to avoid a flash of the boot theme.
func PrePaintScript(bootTheme string) string {
	return `<script>(function(){var t=null;try{t=localStorage.getItem('stigmergic-theme')}catch(e){}document.documentElement.setAttribute('data-theme',t||` + strconv.Quote(bootTheme) + `)})()</script>`
}

// ThemeConfig is the client-side theme registry emitted as JSON: the boot
// theme, the cycle order, and each theme's paired mermaid theme.
type ThemeConfig struct {
	Boot    string            `json:"boot"`
	Order   []string          `json:"order"`
	Mermaid map[string]string `json:"mermaid"`
}

func buildThemeConfig(thm *theme.Theme, themes []*theme.Theme) ThemeConfig {
	cfg := ThemeConfig{Boot: thm.Name, Mermaid: map[string]string{thm.Name: thm.MermaidTheme}}
	for _, t := range themes {
		cfg.Order = append(cfg.Order, t.Name)
		cfg.Mermaid[t.Name] = t.MermaidTheme
	}
	bootListed := false
	for _, name := range cfg.Order {
		if name == thm.Name {
			bootListed = true
			break
		}
	}
	if !bootListed {
		cfg.Order = append([]string{thm.Name}, cfg.Order...)
	}
	return cfg
}

const sharedThemeRules = `
	body {
		background-color: var(--bg-color);
		color: var(--fg-color);
	}
	a {
		color: var(--link-color);
	}
	a:hover {
		color: var(--link-hover-color);
	}
	code {
		background-color: var(--code-bg-color);
		color: var(--code-fg-color);
		padding: 0.125rem 0.25rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}
	pre {
		background-color: var(--code-bg-color);
	}
	pre code {
		color: var(--code-fg-color);
		background-color: transparent;
		padding: 0;
	}
	.tree-item-text {
		color: var(--fg-color);
	}
	.tree-item-folder {
		color: var(--cyan-color);
	}
	.tree-item-icon {
		color: var(--comment-color);
	}
	.tree-item:hover,
	.tree-item:focus {
		background-color: var(--selection-color);
	}
	[data-nav-item]:hover,
	[data-nav-item]:focus {
		background-color: var(--selection-color);
		border-radius: 0.375rem;
	}
	#content:focus {
		outline: none;
	}
	.prose {
		color: var(--fg-color);
		--tw-prose-body: var(--fg-color);
		--tw-prose-headings: var(--fg-color);
		--tw-prose-lead: var(--comment-color);
		--tw-prose-links: var(--link-color);
		--tw-prose-bold: var(--fg-color);
		--tw-prose-counters: var(--comment-color);
		--tw-prose-bullets: var(--comment-color);
		--tw-prose-hr: var(--border-color);
		--tw-prose-quotes: var(--cyan-color);
		--tw-prose-quote-borders: var(--border-color);
		--tw-prose-captions: var(--comment-color);
		--tw-prose-code: var(--code-fg-color);
		--tw-prose-pre-code: var(--fg-color);
		--tw-prose-pre-bg: var(--code-bg-color);
		--tw-prose-th-borders: var(--border-color);
		--tw-prose-td-borders: var(--border-color);
	}
	.prose img {
		border-radius: 0.375rem;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
		border: 1px solid var(--border-color);
	}
	.prose code::before,
	.prose code::after {
		content: none;
	}
	.tree-item-current {
		background-color: var(--selection-color);
	}
	.outline-link {
		color: var(--comment-color);
	}
	.outline-link:hover {
		color: var(--fg-color);
	}
	.outline-link-active {
		color: var(--green-color);
	}
`

