package components

import (
	"strconv"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/models"
	"github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
)

func themeCSS(thm *theme.Theme) string {
	return `<style type="text/css">:root {
		--bg-color: ` + thm.Colors.Background + `;
		--fg-color: ` + thm.Colors.Foreground + `;
		--bg-alt-color: ` + thm.Colors.BackgroundAlt + `;
		--comment-color: ` + thm.Colors.Comment + `;
		--current-line-color: ` + thm.Colors.CurrentLine + `;
		--selection-color: ` + thm.Colors.Selection + `;
		--line-number-color: ` + thm.Colors.LineNumber + `;
		--line-number-active-color: ` + thm.Colors.LineNumberActive + `;
		--red-color: ` + thm.Colors.Red + `;
		--orange-color: ` + thm.Colors.Orange + `;
		--yellow-color: ` + thm.Colors.Yellow + `;
		--green-color: ` + thm.Colors.Green + `;
		--cyan-color: ` + thm.Colors.Cyan + `;
		--blue-color: ` + thm.Colors.Blue + `;
		--purple-color: ` + thm.Colors.Purple + `;
		--link-color: ` + thm.Colors.Link + `;
		--link-hover-color: ` + thm.Colors.LinkHover + `;
		--code-bg-color: ` + thm.Colors.CodeBg + `;
		--code-fg-color: ` + thm.Colors.CodeFg + `;
		--border-color: ` + thm.Colors.BorderColor + `;
	}
	body {
		background-color: var(--bg-color);
		color: var(--fg-color);
	}
	a {
		color: var(--link-color);
	}
	a:hover {
		color: var(--link-hover-color);
	}
	code {
		background-color: var(--code-bg-color);
		color: var(--code-fg-color);
		padding: 0.125rem 0.25rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}
	pre {
		background-color: var(--code-bg-color);
	}
	pre code {
		color: var(--code-fg-color);
		background-color: transparent;
		padding: 0;
	}
	.tree-item-text {
		color: var(--fg-color);
	}
	.tree-item-folder {
		color: var(--cyan-color);
	}
	.tree-item-icon {
		color: var(--comment-color);
	}
	.tree-item:hover,
	.tree-item:focus {
		background-color: var(--selection-color);
	}
	[data-nav-item]:hover,
	[data-nav-item]:focus {
		background-color: var(--selection-color);
		border-radius: 0.375rem;
	}
	.prose {
		color: var(--fg-color);
		--tw-prose-body: var(--fg-color);
		--tw-prose-headings: var(--fg-color);
		--tw-prose-lead: var(--comment-color);
		--tw-prose-links: var(--link-color);
		--tw-prose-bold: var(--fg-color);
		--tw-prose-counters: var(--comment-color);
		--tw-prose-bullets: var(--comment-color);
		--tw-prose-hr: var(--border-color);
		--tw-prose-quotes: var(--cyan-color);
		--tw-prose-quote-borders: var(--border-color);
		--tw-prose-captions: var(--comment-color);
		--tw-prose-code: var(--code-fg-color);
		--tw-prose-pre-code: var(--fg-color);
		--tw-prose-pre-bg: var(--code-bg-color);
		--tw-prose-th-borders: var(--border-color);
		--tw-prose-td-borders: var(--border-color);
	}
	.prose img {
		border-radius: 0.375rem;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);
		border: 1px solid var(--border-color);
	}
	.prose code::before,
	.prose code::after {
		content: none;
	}
	.indicator-connecting {
		background-color: var(--comment-color);
	}
	.indicator-connected {
		background-color: var(--green-color);
	}
	.indicator-disconnected {
		background-color: var(--red-color);
	}
	.indicator-reconnecting {
		background-color: var(--yellow-color);
		animation: indicator-spin 1s linear infinite;
	}
	.indicator-reloading {
		background-color: var(--green-color);
		animation: indicator-pulse 0.5s ease-in-out;
	}
	@keyframes indicator-pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.6; transform: scale(1.4); }
	}
	@keyframes indicator-spin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}</style>`
}

