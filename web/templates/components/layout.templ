templ Layout(title string, thm *theme.Theme, themes []*theme.Theme, files []models.SearchableFile, tree *models.Tree, recentFiles []models.SearchableFile, indexReady bool, caps models.UICapabilities, outline []models.OutlineEntry) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templ.Raw(PrePaintScript(thm.Name))
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Markdown file watcher and renderer"/>
			<title>{ title } - stigmergic</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/styles/output.css"/>
			@templ.Raw(ThemeCSS(thm, themes))
			<link rel="stylesheet" href="/static/css/katex.min.css"/>
			<script defer src="/static/js/katex.min.js"></script>
			<script defer src="/static/js/katex-auto-render.min.js"></script>
			<script src="/static/js/mermaid.min.js"></script>
			@templ.JSONScript("theme-config", buildThemeConfig(thm, themes))
			<script>
				(function(){
					var cfg = JSON.parse(document.getElementById('theme-config').textContent);
					var active = document.documentElement.getAttribute('data-theme') || cfg.boot;
					mermaid.initialize({
						startOnLoad: false,
						theme: cfg.mermaid[active] || 'dark'
					});
				})();
			</script>
			<script src="/static/js/wiremd.min.js"></script>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sse.js"></script>
			<script src="/static/js/fuse.min.js"></script>
			<script src="/static/js/alpine-focus.min.js" defer></script>
			<script src="/static/js/alpine.min.js" defer></script>
			@templ.JSONScript("markdown-files", files)
			<script src="/static/js/app/render.js"></script>
			<script src="/static/js/app/nav.js"></script>
			<script src="/static/js/app/events.js"></script>
			<script src="/static/js/app/follow.js"></script>
			<script src="/static/js/app/ui.js"></script>
		</head>
		<body class="h-screen overflow-hidden flex flex-col" hx-ext="sse" sse-connect="/events" hx-trigger="sse:message" style="background-color: var(--bg-color); color: var(--fg-color);" data-index-ready={ strconv.FormatBool(indexReady) } data-gitignore-enabled={ strconv.FormatBool(caps.GitignoreToggle) } x-data="{ sidebarOpen: true }">
			<div x-data="scrollProgress()" class="fixed top-0 left-0 w-full h-1 z-50" style="background-color: var(--bg-alt-color);">
				<div class="h-full transition-all duration-75" :style="{ backgroundColor: 'var(--green-color)', width: progress + '%' }"></div>
			</div>
			@CommandPalette()
			@Help()
			<header class="shrink-0" style="background-color: var(--bg-alt-color); border-bottom: 1px solid var(--border-color);">
				<div class="px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
					<div class="flex items-center gap-2">
						<button @click="sidebarOpen = !sidebarOpen" title="Toggle sidebar" class="p-1 rounded-md transition-colors hidden md:block" style="color: var(--comment-color);">
							<svg class="w-5 h-5 transition-transform" :class="sidebarOpen ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</button>
						<a href="/" class="flex items-center gap-3" style="color: var(--fg-color); text-decoration: none;">
							@BuildtallLogo()
							<span class="text-2xl font-bold">stigmergic</span>
						</a>
					</div>
					<div class="flex items-center gap-2">
						<button @click="$dispatch('toggle-palette')" class="flex items-center gap-2 px-3 py-1.5 text-sm rounded-md transition-colors cursor-pointer" style="background-color: var(--bg-color); border: 1px solid var(--border-color); color: var(--comment-color);">
							@IconSearch("w-4 h-4", "")
							<span>Search</span>
							<kbd class="px-1.5 py-0.5 rounded text-xs" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">Ctrl+K</kbd>
						</button>
						if caps.FollowMode {
							<div x-data="{ scopeOpen: false }" class="relative">
								<div class="flex items-center rounded-md" style="background-color: var(--bg-color); border: 1px solid var(--border-color);">
									<button
										data-follow-toggle
										hx-push-url="true"
										@click="$store.follow.toggle()"
										title="Toggle follow mode (F)"
										class="px-3 py-1.5 text-sm rounded-l-md transition-colors cursor-pointer"
										:style="$store.follow.active ? 'color: var(--green-color); font-weight: 600;' : ($store.follow.enabled ? 'color: var(--orange-color);' : 'color: var(--comment-color);')"
										x-text="$store.follow.label()"
									>Follow</button>
									<button @click="scopeOpen = !scopeOpen" title="Follow scope" class="px-1.5 py-2 rounded-r-md transition-colors cursor-pointer" style="color: var(--comment-color); border-left: 1px solid var(--border-color);">
										<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
										</svg>
									</button>
								</div>
								<div x-cloak x-show="scopeOpen" @click.outside="scopeOpen = false" class="absolute right-0 top-full mt-1 z-50 w-64 rounded-md shadow-2xl p-3 space-y-2" style="background-color: var(--bg-color); border: 1px solid var(--border-color);">
									<p class="text-sm font-semibold">Follow scope</p>
									<label class="flex items-center gap-2 text-sm cursor-pointer">
										<input type="radio" name="follow-scope" value="corpus" :checked="$store.follow.scope === 'corpus'" @change="$store.follow.setScope('corpus')"/>
										<span>Entire corpus</span>
									</label>
									<label class="flex items-center gap-2 text-sm cursor-pointer">
										<input type="radio" name="follow-scope" value="dir" :checked="$store.follow.scope === 'dir'" @change="$store.follow.setScope('dir')"/>
										<span>Current directory only</span>
									</label>
									<div class="pt-2 space-y-2" style="border-top: 1px solid var(--border-color);">
										<p class="text-sm font-semibold">Behavior</p>
										<label class="flex items-center gap-2 text-sm cursor-pointer" title="When following, navigating by hand pauses follow so a change elsewhere doesn't pull you away from what you're reading. Press F or click Follow to resume.">
											<input type="checkbox" :checked="$store.follow.autoPause" @change="$store.follow.setAutoPause($event.target.checked)"/>
											<span>Auto-pause on navigation</span>
										</label>
									</div>
								</div>
							</div>
						}
						<button @click="cycleTheme()" title="Cycle theme (T)" class="px-3 py-1.5 text-sm rounded-md transition-colors cursor-pointer" style="background-color: var(--bg-color); border: 1px solid var(--border-color); color: var(--comment-color);">Theme</button>
						<button @click="$dispatch('toggle-help')" title="Keyboard shortcuts" class="px-3 py-1.5 text-sm rounded-md transition-colors cursor-pointer" style="background-color: var(--bg-color); border: 1px solid var(--border-color); color: var(--comment-color);">?</button>
					</div>
				</div>
			</header>
			<div class="flex flex-1 min-h-0">
				<aside id="sidebar" x-show="sidebarOpen" class="hidden md:block w-64 shrink-0 overflow-y-auto p-3" style="background-color: var(--bg-alt-color); border-right: 1px solid var(--border-color);">
					@Sidebar(tree, recentFiles, indexReady, caps)
				</aside>
				<main id="content" tabindex="0" class="flex-1 min-w-0 overflow-y-auto px-4 sm:px-6 lg:px-8 py-8">
					{ children... }
				</main>
				<aside id="outline" class="hidden min-[1100px]:block w-56 shrink-0 overflow-y-auto p-4" style="border-left: 1px solid var(--border-color);">
						@Outline(outline)
					</aside>
			</div>
		</body>
	</html>
}
