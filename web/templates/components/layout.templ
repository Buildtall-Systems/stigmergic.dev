package components

import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"

func themeCSS(thm *theme.Theme) string {
	return `<style type="text/css">:root {
		--bg-color: ` + thm.Colors.Background + `;
		--fg-color: ` + thm.Colors.Foreground + `;
		--bg-alt-color: ` + thm.Colors.BackgroundAlt + `;
		--comment-color: ` + thm.Colors.Comment + `;
		--current-line-color: ` + thm.Colors.CurrentLine + `;
		--selection-color: ` + thm.Colors.Selection + `;
		--line-number-color: ` + thm.Colors.LineNumber + `;
		--line-number-active-color: ` + thm.Colors.LineNumberActive + `;
		--red-color: ` + thm.Colors.Red + `;
		--orange-color: ` + thm.Colors.Orange + `;
		--yellow-color: ` + thm.Colors.Yellow + `;
		--green-color: ` + thm.Colors.Green + `;
		--cyan-color: ` + thm.Colors.Cyan + `;
		--blue-color: ` + thm.Colors.Blue + `;
		--purple-color: ` + thm.Colors.Purple + `;
		--link-color: ` + thm.Colors.Link + `;
		--link-hover-color: ` + thm.Colors.LinkHover + `;
		--code-bg-color: ` + thm.Colors.CodeBg + `;
		--code-fg-color: ` + thm.Colors.CodeFg + `;
		--border-color: ` + thm.Colors.BorderColor + `;
	}
	body {
		background-color: var(--bg-color);
		color: var(--fg-color);
	}
	a {
		color: var(--link-color);
	}
	a:hover {
		color: var(--link-hover-color);
	}
	code {
		background-color: var(--code-bg-color);
		color: var(--code-fg-color);
	}
	pre {
		background-color: var(--code-bg-color);
	}
	pre code {
		color: var(--code-fg-color);
	}
	.tree-item-text {
		color: var(--fg-color);
	}
	.tree-item-folder {
		color: var(--cyan-color);
	}
	.tree-item-icon {
		color: var(--comment-color);
	}
	.tree-item:hover {
		background-color: var(--selection-color);
	}
	.prose {
		color: var(--fg-color);
		--tw-prose-body: var(--fg-color);
		--tw-prose-headings: var(--fg-color);
		--tw-prose-lead: var(--comment-color);
		--tw-prose-links: var(--link-color);
		--tw-prose-bold: var(--fg-color);
		--tw-prose-counters: var(--comment-color);
		--tw-prose-bullets: var(--comment-color);
		--tw-prose-hr: var(--border-color);
		--tw-prose-quotes: var(--cyan-color);
		--tw-prose-quote-borders: var(--border-color);
		--tw-prose-captions: var(--comment-color);
		--tw-prose-code: var(--orange-color);
		--tw-prose-pre-code: var(--fg-color);
		--tw-prose-pre-bg: var(--code-bg-color);
		--tw-prose-th-borders: var(--border-color);
		--tw-prose-td-borders: var(--border-color);
	}</style>`
}

templ Layout(title string, thm *theme.Theme) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content="Markdown file watcher and renderer"/>
			<title>{ title } - stigmergic</title>
			<link rel="stylesheet" href="/static/styles/output.css"/>
			@templ.Raw(themeCSS(thm))
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" integrity="sha384-5TcZemv2l/9On385z///+d7MSYlvIEw9FuZTIdZ14vJLqWphw7e7ZPuOiCHJcFCP" crossorigin="anonymous"/>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js" integrity="sha384-cMkvdD8LoxVzGF/RPUKAcvmm49FQ0oxwDF3BGKtDXcEc+T1b2N+teh/OJfpU0jr6" crossorigin="anonymous"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/contrib/auto-render.min.js" integrity="sha384-hCXGrW6PitJEwbkoStFjeJxv+fSOOQKOPbJxSfM6G5sWZjAyWhXiTIIAmQqnlLlh" crossorigin="anonymous"></script>
			<script type="module">
				import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
				mermaid.initialize({ startOnLoad: true });
			</script>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/sse.js"></script>
			<script>
				document.addEventListener("DOMContentLoaded", function() {
					renderMathInElement(document.body, {
						delimiters: [
							{left: '$$', right: '$$', display: true},
							{left: '$', right: '$', display: false}
						],
						throwOnError: false
					});
					document.body.addEventListener('htmx:sseMessage', function(evt) {
						htmx.ajax('GET', window.location.pathname, {target: 'main', swap: 'innerHTML'});
					});
				});
			</script>
		</head>
		<body class="min-h-screen" hx-ext="sse" sse-connect="/events" style="background-color: var(--bg-color); color: var(--fg-color);">
			<header style="background-color: var(--bg-alt-color); border-bottom: 1px solid var(--border-color);">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
					<h1 class="text-2xl font-bold" style="color: var(--fg-color);">stigmergic</h1>
				</div>
			</header>
			<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
				{ children... }
			</main>
		</body>
	</html>
}
