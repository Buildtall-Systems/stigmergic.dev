package components

templ CommandPalette() {
	<div x-data="commandPalette()" x-init="init()" @keydown.ctrl.k.window.prevent="togglePalette()" @toggle-palette.window="togglePalette()" hx-push-url="true">
		<div x-cloak x-show="open" class="fixed inset-0 bg-black/50 z-40" @click="close()"></div>

		<div x-cloak x-show="open" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 w-full max-w-2xl" x-trap="open" @click.away="close()">
			<div class="rounded-lg shadow-2xl" style="background-color: var(--bg-color); border: 1px solid var(--border-color);">
				<div class="p-4 border-b flex items-center gap-3" style="border-bottom-color: var(--border-color);">
					@IconSearch("w-5 h-5 flex-shrink-0", "color: var(--comment-color);")
					<input
						x-ref="searchInput"
						type="text"
						placeholder="Search files and commands..."
						x-model="query"
						@input="debouncedFilter()"
						@keydown.down="nextResult()"
						@keydown.up="prevResult()"
						@keydown.enter="selectResult()"
						@keydown.escape="close()"
						class="flex-1 bg-transparent outline-hidden"
						style="color: var(--fg-color);"
					/>
					<button @click="close()" class="flex-shrink-0 p-1 rounded hover:opacity-80 transition-opacity" style="color: var(--comment-color);">
						@IconClose("w-5 h-5", "")
					</button>
				</div>

				<template id="icon-file">
					@IconFile("w-5 h-5 flex-shrink-0", "")
				</template>
				<template id="icon-command">
					@IconTerminal("w-5 h-5 flex-shrink-0", "")
				</template>
				<template id="icon-return">
					@IconReturn("w-4 h-4", "")
				</template>

				<div class="max-h-96 overflow-y-auto" x-ref="resultsList">
					<template x-if="results.length === 0">
						<div class="p-4 text-center" style="color: var(--comment-color);">
							<span x-show="!indexReady">Indexing...</span>
							<span x-show="indexReady && query">No matches found</span>
							<span x-show="indexReady && !query">Type to search files and commands</span>
						</div>
					</template>

					<template x-if="groupedResults.commands.length > 0">
						<div>
							<div class="px-4 py-2 text-xs font-semibold uppercase tracking-wider" style="color: var(--cyan-color); background-color: var(--bg-alt-color);">
								Commands
							</div>
							<template x-for="item in groupedResults.commands" :key="item.id">
								<div
									@click="selectIndex(item.resultIndex)"
									@mouseover="selectedIndex = item.resultIndex"
									:data-selected="selectedIndex === item.resultIndex"
									:style="selectedIndex === item.resultIndex ? 'background-color: var(--selection-color);' : ''"
									class="px-4 py-3 cursor-pointer transition-colors flex items-center gap-3"
								>
									<span x-html="getIcon('command')" style="color: var(--purple-color);"></span>
									<div class="flex-1 min-w-0">
										<div style="color: var(--fg-color);" x-html="highlightMatch(item)"></div>
										<div x-show="item.description" style="color: var(--comment-color); font-size: 0.875em;" class="truncate" x-text="item.description"></div>
									</div>
									<span x-show="selectedIndex === item.resultIndex" x-html="getReturnIcon()" style="color: var(--fg-color);"></span>
								</div>
							</template>
						</div>
					</template>

					<template x-if="groupedResults.files.length > 0">
						<div>
							<div class="px-4 py-2 text-xs font-semibold uppercase tracking-wider" style="color: var(--cyan-color); background-color: var(--bg-alt-color);">
								Files
							</div>
							<template x-for="item in groupedResults.files" :key="item.id">
								<div
									@click="selectIndex(item.resultIndex)"
									@mouseover="selectedIndex = item.resultIndex"
									:data-selected="selectedIndex === item.resultIndex"
									:style="selectedIndex === item.resultIndex ? 'background-color: var(--selection-color);' : ''"
									class="px-4 py-3 cursor-pointer transition-colors flex items-center gap-3"
								>
									<span x-html="getIcon('file')" style="color: var(--comment-color);"></span>
									<div class="flex-1 min-w-0">
										<div style="color: var(--fg-color);" x-html="highlightMatch(item)"></div>
										<div style="color: var(--comment-color); font-size: 0.875em;" class="truncate" x-text="item.description"></div>
									</div>
									<span x-show="selectedIndex === item.resultIndex" x-html="getReturnIcon()" style="color: var(--fg-color);"></span>
								</div>
							</template>
						</div>
					</template>
				</div>

				<div class="px-4 py-3 border-t flex items-center justify-center gap-6 text-xs" style="border-top-color: var(--border-color); color: var(--comment-color);">
					<span class="flex items-center gap-1">
						<kbd class="px-1.5 py-0.5 rounded" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">↵</kbd>
						<span>to select</span>
					</span>
					<span class="flex items-center gap-1">
						<kbd class="px-1.5 py-0.5 rounded" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">↓</kbd>
						<kbd class="px-1.5 py-0.5 rounded" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">↑</kbd>
						<span>to navigate</span>
					</span>
					<span class="flex items-center gap-1">
						<kbd class="px-1.5 py-0.5 rounded" style="background-color: var(--bg-alt-color); border: 1px solid var(--border-color);">esc</kbd>
						<span>to close</span>
					</span>
				</div>
			</div>
		</div>
	</div>

	<script src="/static/js/command-palette.js"></script>
}
