package components

templ CommandPalette() {
	<div x-data="commandPalette()" x-init="init()" @keydown.ctrl.k.window.prevent="togglePalette()">
		<div x-cloak x-show="open" class="fixed inset-0 bg-black/50 z-40" @click="close()"></div>

		<div x-cloak x-show="open" class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 w-full max-w-2xl" x-trap="open" @click.away="close()">
			<div class="rounded-lg shadow-2xl" style="background-color: var(--bg-color); border: 1px solid var(--border-color);">
				<div class="p-4 border-b" style="border-bottom-color: var(--border-color);">
					<input
						x-ref="searchInput"
						type="text"
						placeholder="Search files and commands... (Ctrl+K)"
						x-model="query"
						@input="filter()"
						@keydown.down="nextResult()"
						@keydown.up="prevResult()"
						@keydown.enter="selectResult()"
						@keydown.escape="close()"
						class="w-full px-0 py-2 bg-transparent outline-hidden"
						style="color: var(--fg-color);"
					/>
				</div>

				<div class="max-h-96 overflow-y-auto" x-ref="resultsList">
					<template x-if="results.length === 0">
						<div class="p-4 text-center" style="color: var(--comment-color);">
							<span x-show="query">No matches found</span>
							<span x-show="!query">No files</span>
						</div>
					</template>

					<template x-for="(item, index) in results" :key="item.id">
						<div
							@click="selectIndex(index)"
							@mouseover="selectedIndex = index"
							:data-selected="selectedIndex === index"
							:style="selectedIndex === index ? 'background-color: var(--selection-color);' : ''"
							class="px-4 py-3 border-b cursor-pointer transition-colors"
							style="border-bottom-color: var(--border-color);"
						>
							<div class="flex items-center gap-2">
								<span x-show="item.type === 'command'" style="color: var(--purple-color);">&gt;</span>
								<span style="color: var(--fg-color);" x-text="item.name"></span>
							</div>
							<div x-show="item.description" style="color: var(--comment-color); font-size: 0.875em;" x-text="item.description"></div>
						</div>
					</template>
				</div>
			</div>
		</div>
	</div>

	<script>
		function commandPalette() {
			return {
				open: false,
				query: '',
				allFiles: [],
				commands: [
					{ id: 'cmd:home', type: 'command', name: 'Home', description: 'Go to index page', action: () => window.location.href = '/' }
				],
				results: [],
				selectedIndex: 0,

				init() {
					this.loadFiles()
					document.body.addEventListener('htmx:afterSwap', () => this.refreshFiles())
				},

				loadFiles() {
					const filesEl = document.getElementById('markdown-files');
					if (filesEl) {
						this.allFiles = JSON.parse(filesEl.textContent).map(f => ({
							id: 'file:' + f.Path,
							type: 'file',
							name: f.Name,
							description: f.Path,
							path: f.Path
						}));
					}
					this.results = [...this.allFiles];
				},

				refreshFiles() {
					fetch('/api/files')
						.then(res => res.json())
						.then(files => {
							this.allFiles = files.map(f => ({
								id: 'file:' + f.Path,
								type: 'file',
								name: f.Name,
								description: f.Path,
								path: f.Path
							}));
							this.filter();
						})
						.catch(err => console.error('Failed to refresh files:', err));
				},

				togglePalette() {
					if (this.open) {
						this.close();
					} else {
						this.open = true;
						this.$nextTick(() => this.$refs.searchInput.focus());
					}
				},

				close() {
					this.open = false;
					this.query = '';
					this.selectedIndex = 0;
					this.filter();
				},

				filter() {
					if (!this.query.trim()) {
						this.results = [...this.allFiles];
						this.selectedIndex = 0;
						return;
					}

					const allItems = [...this.commands, ...this.allFiles];
					const fuse = new Fuse(allItems, {
						keys: ['name', 'description'],
						threshold: 0.4,
						includeScore: true
					});

					const searchResults = fuse.search(this.query);
					const commands = searchResults.filter(r => r.item.type === 'command').map(r => r.item);
					const files = searchResults.filter(r => r.item.type === 'file').map(r => r.item);
					this.results = [...commands, ...files];
					this.selectedIndex = 0;
				},

				nextResult() {
					if (this.selectedIndex < this.results.length - 1) {
						this.selectedIndex++;
						this.scrollToSelected();
					}
				},

				prevResult() {
					if (this.selectedIndex > 0) {
						this.selectedIndex--;
						this.scrollToSelected();
					}
				},

				scrollToSelected() {
					this.$nextTick(() => {
						const container = this.$refs.resultsList;
						const selected = container?.querySelector('[data-selected="true"]');
						if (selected) {
							selected.scrollIntoView({ block: 'nearest' });
						}
					});
				},

				selectResult() {
					if (this.results.length > 0) {
						this.selectIndex(this.selectedIndex);
					}
				},

				selectIndex(index) {
					if (index >= 0 && index < this.results.length) {
						const item = this.results[index];
						this.close();
						if (item.type === 'command') {
							item.action();
						} else {
							window.location.href = '/file' + item.path;
						}
					}
				}
			}
		}
	</script>
}
