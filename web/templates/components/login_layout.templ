package components

import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"

templ LoginLayout(thm *theme.Theme, themes []*theme.Theme) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templ.Raw(PrePaintScript(thm.Name))
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sign In — stigmergic</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			@templ.Raw(ThemeCSS(thm, themes))
			<style>
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: system-ui, -apple-system, sans-serif;
					display: flex;
					align-items: center;
					justify-content: center;
					min-height: 100vh;
				}
				.container {
					max-width: 400px;
					width: 100%;
					padding: 2rem;
					text-align: center;
				}
				.container svg {
					margin: 0 auto 1rem;
				}
				h1 {
					font-size: 1.5rem;
					margin-bottom: 0.5rem;
				}
				.subtitle {
					color: var(--comment-color);
					margin-bottom: 2rem;
					font-size: 0.9rem;
				}
				.btn {
					display: inline-block;
					padding: 0.75rem 1.5rem;
					border: 1px solid var(--cyan-color);
					color: var(--cyan-color);
					background: transparent;
					border-radius: 6px;
					font-size: 1rem;
					cursor: pointer;
					transition: all 0.2s;
				}
				.btn:hover { background: var(--cyan-color); color: var(--bg-color); }
				.btn:disabled { opacity: 0.5; cursor: not-allowed; }
				.error-msg {
					background: var(--bg-alt-color);
					border: 1px solid var(--red-color);
					color: var(--red-color);
					padding: 0.75rem;
					border-radius: 6px;
					margin-bottom: 1rem;
					font-size: 0.875rem;
				}
				.info {
					color: var(--comment-color);
					margin-top: 1.5rem;
					font-size: 0.8rem;
				}
				#status {
					margin-top: 1rem;
					font-size: 0.875rem;
					color: var(--comment-color);
				}
				.spinner {
					display: inline-block;
					width: 16px;
					height: 16px;
					border: 2px solid var(--comment-color);
					border-top-color: var(--cyan-color);
					border-radius: 50%;
					animation: spin 0.6s linear infinite;
					margin-right: 0.5rem;
					vertical-align: middle;
				}
				@keyframes spin { to { transform: rotate(360deg); } }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
