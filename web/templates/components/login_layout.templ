package components

import (
	btkauth "github.com/buildtall-systems/buildtall/btk/views/auth"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
)

templ LoginLayout(thm *theme.Theme, themes []*theme.Theme) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@templ.Raw(PrePaintScript(thm.Name))
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sign In — stigmergic</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/styles/output.css"/>
			@templ.Raw(ThemeCSS(thm, themes))
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/btk/js/btk-components.js"></script>
			<script src="/static/btk/js/nostr.js"></script>
			@btkauth.XCloakStyle()
			<script src="/static/js/alpine.min.js" defer></script>
		</head>
		<body class="min-h-screen flex items-center justify-center" style="background-color: var(--bg-color); color: var(--fg-color);">
			{ children... }
		</body>
	</html>
}
