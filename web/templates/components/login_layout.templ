package components

templ LoginLayout() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sign In — stigmergic</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<style>
				* { margin: 0; padding: 0; box-sizing: border-box; }
				body {
					font-family: system-ui, -apple-system, sans-serif;
					background: #161821;
					color: #c6c8d1;
					display: flex;
					align-items: center;
					justify-content: center;
					min-height: 100vh;
				}
				.container {
					max-width: 400px;
					width: 100%;
					padding: 2rem;
					text-align: center;
				}
				.container svg {
					margin: 0 auto 1rem;
				}
				h1 {
					font-size: 1.5rem;
					margin-bottom: 0.5rem;
					color: #d2d4de;
				}
				.subtitle {
					color: #6b7089;
					margin-bottom: 2rem;
					font-size: 0.9rem;
				}
				.btn {
					display: inline-block;
					padding: 0.75rem 1.5rem;
					border: 1px solid #89b8c2;
					color: #89b8c2;
					background: transparent;
					border-radius: 6px;
					font-size: 1rem;
					cursor: pointer;
					transition: all 0.2s;
				}
				.btn:hover { background: #89b8c2; color: #161821; }
				.btn:disabled { opacity: 0.5; cursor: not-allowed; }
				.error-msg {
					background: #e2787844;
					border: 1px solid #e27878;
					color: #e27878;
					padding: 0.75rem;
					border-radius: 6px;
					margin-bottom: 1rem;
					font-size: 0.875rem;
				}
				.info {
					color: #6b7089;
					margin-top: 1.5rem;
					font-size: 0.8rem;
				}
				.info a { color: #89b8c2; }
				#status {
					margin-top: 1rem;
					font-size: 0.875rem;
					color: #6b7089;
				}
				.spinner {
					display: inline-block;
					width: 16px;
					height: 16px;
					border: 2px solid #6b7089;
					border-top-color: #89b8c2;
					border-radius: 50%;
					animation: spin 0.6s linear infinite;
					margin-right: 0.5rem;
					vertical-align: middle;
				}
				@keyframes spin { to { transform: rotate(360deg); } }
			</style>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
