package components

import (
	"strconv"

	"github.com/Buildtall-Systems/stigmergic.dev/internal/models"
)

// Tree renders one level of the content tree. A directory in expanded carries
// its children inline; every other directory emits an empty container tagged
// with its path, which nav.js fills from /partial/tree/ on first expand. The
// same markup serves the full sidebar and the per-directory partial, so a
// swapped-in subtree is indistinguishable from one that shipped with the page.
templ Tree(node *models.Node, expanded models.ExpandedDirs) {
	<ul class="space-y-1 pl-2">
		for _, child := range node.Children {
			<li>
				if child.IsDir() {
					@treeDirectory(child, expanded)
				} else {
					@treeFile(child)
				}
			</li>
		}
	</ul>
}

// treeDirectory renders a directory row above its children container. The
// container is emitted whether or not the children shipped, so nav.js always
// has a stable swap target and expandAncestors always has a chain to walk.
templ treeDirectory(node *models.Node, expanded models.ExpandedDirs) {
	<div class="flex flex-col">
		<div class="flex items-center cursor-pointer" data-expanded={ strconv.FormatBool(expanded.Has(node.Path)) } onclick="toggleDirectory(this)">
			<div class="chevron-btn p-1 mr-1">
				<svg class={ chevronClass(expanded.Has(node.Path)) }><use href="#tree-icon-chevron"></use></svg>
			</div>
			<div class="tree-item group flex-1">
				<svg class="tree-item-icon"><use href="#tree-icon-folder"></use></svg>
				<span class="tree-item-text tree-item-folder">{ node.Name }</span>
			</div>
		</div>
		if expanded.Has(node.Path) {
			<div class="directory-children" data-children-path={ node.Path } data-loaded="true">
				@Tree(node, expanded)
			</div>
		} else {
			<div class="directory-children" data-children-path={ node.Path } data-loaded="false" style="display: none;"></div>
		}
	</div>
}

templ treeFile(node *models.Node) {
	<a
		href={ templ.SafeURL("/file/" + templ.EscapeString(node.Path)) }
		class="tree-item group focus:outline-hidden"
		hx-get={ "/file/" + templ.EscapeString(node.Path) }
		hx-target="#content"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-nav-item
		data-path={ node.Path }
	>
		<svg class="tree-item-icon"><use href="#tree-icon-file"></use></svg>
		<span class="tree-item-text">{ node.Name }</span>
	</a>
}

func chevronClass(expanded bool) string {
	if expanded {
		return "w-4 h-4 transform rotate-90"
	}
	return "w-4 h-4"
}
