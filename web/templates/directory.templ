package templates

import "github.com/Buildtall-Systems/stigmergic.dev/internal/models"
import "github.com/Buildtall-Systems/stigmergic.dev/internal/theme"
import "github.com/Buildtall-Systems/stigmergic.dev/web/templates/components"

templ Directory(title string, breadcrumbs []models.Breadcrumb, node *models.Node, rootPath string, mount string, thm *theme.Theme, themes []*theme.Theme, treeView models.TreeView, recentFiles []models.SearchableFile, indexReady bool, caps models.UICapabilities) {
	@components.Layout(title, thm, themes, treeView, recentFiles, indexReady, caps, nil) {
		@DirectoryContent(breadcrumbs, node, rootPath, mount)
	}
}

// mount is the route prefix of the source the listing describes, which the
// rows link through: a directory read from a vault lists into that vault.
templ DirectoryContent(breadcrumbs []models.Breadcrumb, node *models.Node, rootPath string, mount string) {
	<div class="space-y-6">
		if len(breadcrumbs) > 0 {
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol class="flex items-center space-x-2">
					<li class="inline-flex items-center">
						<a href="/" hx-get="/" hx-target="#content" hx-swap="innerHTML" hx-push-url="true" class="font-medium transition-colors">
							{ rootPath }
						</a>
					</li>
					for i, crumb := range breadcrumbs {
						<li>
							<div class="flex items-center">
								<span class="breadcrumb-separator mx-2" style="color: var(--comment-color);">/</span>
								if i == len(breadcrumbs) - 1 {
									<span class="font-medium">{ crumb.Name }</span>
								} else {
									<a href={ templ.SafeURL(crumb.Path) } hx-get={ crumb.Path } hx-target="#content" hx-swap="innerHTML" hx-push-url="true" class="font-medium transition-colors" style="color: var(--comment-color);">{ crumb.Name }</a>
								}
							</div>
						</li>
					}
				</ol>
			</nav>
		}
		<div class="space-y-4">
			<h2 class="text-xl font-semibold">{ node.Name }</h2>
			if node != nil && len(node.Children) > 0 {
				// Nil expansion: the listing shows this directory's own
				// entries, with subdirectories expandable on demand. A
				// directory page used to dump its entire subtree, which for a
				// deep directory cost as much as the old sidebar did.
				@components.Tree(node, nil, mount)
			} else {
				<p style="color: var(--comment-color);">Empty directory</p>
			}
		</div>
	</div>
}

