package auth

import (
	"github.com/buildtall-systems/buildtall/btk/auth/identity"
	"github.com/buildtall-systems/buildtall/btk/views/login"
)

// data-signer="bunker" tells btkSigner that this session signs on the server.
templ NavAuth(user *identity.UserInfo, items []identity.MenuItem) {
	<div
		id="nav-auth"
		if user != nil && user.BunkerBacked {
			data-signer="bunker"
		}
	>
		@navAuthInner(user, items)
	</div>
}

templ NavAuthLoading(user *identity.UserInfo, items []identity.MenuItem) {
	@NavAuthLoadingAt(login.DefaultPaths().Me, user, items)
}

// NavAuthLoadingAt is NavAuthLoading for a site whose me route is mePath.
templ NavAuthLoadingAt(mePath string, user *identity.UserInfo, items []identity.MenuItem) {
	<div
		id="nav-auth"
		hx-get={ mePath }
		hx-trigger="load"
		hx-target="this"
		hx-select="unset"
		hx-swap="outerHTML"
		if user != nil && user.BunkerBacked {
			data-signer="bunker"
		}
	>
		@navAuthInner(user, items)
	</div>
}

templ navAuthInner(user *identity.UserInfo, items []identity.MenuItem) {
	if user != nil {
		@avatarDropdown(user, items)
	} else {
		@signInButton()
	}
}

templ signInButton() {
	<button
		id="btk-login-btn"
		onclick="btkLogin()"
		class="inline-flex items-center justify-center px-4 py-2 bg-primary text-bg font-medium rounded-md shadow-sm hover:bg-secondary transition-colors duration-300 text-sm"
	>
		Sign in
	</button>
}

templ avatarDropdown(user *identity.UserInfo, items []identity.MenuItem) {
	<div class="relative" x-data="btkDropdown" x-cloak>
		<button
			@click="toggle()"
			class="flex items-center gap-2 px-3 py-1.5 rounded-lg hover:bg-bg transition-colors"
		>
			if user.Picture != "" {
				<img src={ user.Picture } alt="" class="h-8 w-8 rounded-full object-cover"/>
			} else {
				<div class="h-8 w-8 rounded-full bg-primary flex items-center justify-center text-bg font-bold text-sm">
					{ user.AvatarLetter() }
				</div>
			}
			<span class="text-fg-subtle text-sm hidden sm:inline">{ user.ShortName() }</span>
		</button>
		<div
			x-show="open"
			@click.outside="close()"
			x-transition:enter="transition ease-out duration-200"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-150"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-95"
			class="absolute right-0 mt-2 w-48 bg-bg-subtle rounded-lg shadow-xl border border-fg-muted py-1 z-50"
		>
			<div class="px-4 py-2 border-b border-fg-muted">
				<p class="text-xs text-fg-subtle mb-0">Signed in as</p>
				<p class="text-sm text-fg font-medium truncate mb-0">{ user.ShortName() }</p>
			</div>
			for _, item := range items {
				if item.Visible {
					<a href={ templ.SafeURL(item.URL) } class="block px-4 py-2 text-sm text-fg hover:bg-bg transition-colors">{ item.Label }</a>
				}
			}
			<button onclick="btkLogout()" class="block w-full text-left px-4 py-2 text-sm text-fg hover:bg-bg transition-colors">
				Sign out
			</button>
		</div>
	</div>
}

templ XCloakStyle() {
	<style>[x-cloak]{display:none !important}</style>
}
